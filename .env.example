# Neon Postgres connection string (from the Neon Connect panel).
# Use the DIRECT (unpooled) URL — host WITHOUT "-pooler" — so Prisma
# migrations work; the pooled URL only matters for serverless runtimes.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require"

# Generate with: npx auth secret   (or: openssl rand -base64 33)
# REQUIRED, and must be at least 32 characters — this is the JWT signing key,
# so a short secret means forgeable sessions. Boot fails if it is too short.
AUTH_SECRET="replace-me-with-a-generated-32-plus-character-secret"

# Optional: enables login/register rate limiting (fixed-window, per-IP).
# If unset, the rate limiter fails open (no limiting) and the app still boots.
REDIS_URL="redis://localhost:6379"

# Optional: enables admin EEG image uploads to Vercel Blob.
# Vercel dashboard → Storage → Blob → create store → copy token.
# Without it the app still boots; admin uploads return a clear error.
BLOB_READ_WRITE_TOKEN=""

# Password-reset emails (M6), sent via Resend.
# Get the key at Resend dashboard → API Keys. Without it the app still boots;
# requesting a reset returns a clear error instead of sending mail.
RESEND_API_KEY=""

# Sender address for transactional mail. Keep the Resend SANDBOX sender below
# until you verify a domain — pre-verification, Resend only delivers to the
# account owner's own email. After verifying a domain, change this to
# "Your App <you@yourdomain.com>" (no code change needed).
EMAIL_FROM="EEG Quiz <onboarding@resend.dev>"

# Absolute origin used to build reset links in emails. Defaults to localhost for
# local dev. REQUIRED in production: with NODE_ENV=production, boot FAILS if this
# is still the localhost default, because reset/verification emails would carry
# links pointing at localhost.
APP_URL="http://localhost:3000"
